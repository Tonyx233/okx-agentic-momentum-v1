# ===== Solana RPC =====
# Helius (free tier: https://www.helius.dev) — required for low-latency data
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# ===== Market Data =====
# Birdeye (https://birdeye.so/developers) — DEX analytics, 200+ DEX aggregation
BIRDEYE_API_KEY=

# Jupiter — public, no key needed
JUPITER_API_BASE=https://lite-api.jup.ag

# ===== AI Provider =====
# Anthropic (preferred) — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== Telegram Notifications =====
# Create your own bot via @BotFather to obtain token, and get chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Trading Wallet =====
# Use the OKX Agentic Wallet via onchainos CLI (login with your own OKX account)
# For direct signing, paste a base58-encoded private key (DO NOT commit)
SOLANA_PRIVATE_KEY=
SOLANA_PUBLIC_KEY=

# ===== Strategy Defaults =====
MAX_POSITION_USD=50
MIN_LIQUIDITY_USD=50000
SLIPPAGE_BPS=100
DRY_RUN=true
